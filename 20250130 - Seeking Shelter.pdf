<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?><x:xmpmeta xmlns:x="adobe:ns:meta/">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/" rdf:about="">
         <dc:format>application/pdf</dc:format>
         <dc:rights>
            <rdf:Alt/>
         </dc:rights>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Seeking Shelter - JBS and 3tentos Are Our Top Picks</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:language>en</dc:language>
         <dc:description>
            <rdf:Alt/>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Henrique Brustolin</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Cycles outlook: 2025 to be more about carryover than accelerating momentum.</rdf:li>
               <rdf:li>JBS is the vehicle to play defense.</rdf:li>
               <rdf:li>3tentos is our preferred bottom-up story; Keeping OP for Boa Safra and Jalles.</rdf:li>
               <rdf:li>Better asymmetry for SLC and SMTO, but near-term triggers still lacking.</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:date>2025-01-29T21:58:30-05:00</dc:date>
      </rdf:Description>
      <rdf:Description xmlns:pdf="http://ns.adobe.com/pdf/1.3/" rdf:about="">
